# Python's leavings.
__pycache__/
*.pyc
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# AGENTS.md, CLAUDE.md and .claude/ are committed with the plugin, so whoever
# works on it next, with whichever agent, gets the same instructions. What is
# one person's own is not: their notes, their settings, and what `meridian
# plugin dev` printed for them, which the loop keeps in .meridian/.
CLAUDE.local.md
.claude/settings.local.json
.meridian/

# Real recordings of Databento's responses, a developer's own: never committed
# (Databento's terms; the plan's Q11).
recordings/

# What `make test` leaves behind.
.test.log

# What `make preview` and `make e2e` leave behind: e2e's is the plugin
# harness it copied out of the runtime image, and what the run printed.
preview/
.e2e/
